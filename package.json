{
  "name": "asistente-bibliotecario",
  "version": "0.11.0-field.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "check": "node scripts/build-help.mjs --check && node scripts/check-integrity.mjs && node scripts/build-offline.mjs --check",
    "test": "node --test tests/*.test.js",
    "test:notices-browser": "node tests/notices-browser.cjs",
    "verify": "npm run check && npm test",
    "test:pilot-browser": "node tests/pilot-browser.cjs",
    "test:desk-browser": "node tests/desk-browser.cjs",
    "test:reader-browser": "node tests/reader-browser.cjs",
    "test:cataloging-browser": "node tests/cataloging-browser.cjs",
    "test:assistance-browser": "node tests/assistance-browser.cjs",
    "test:ocr-engine": "node tests/ocr-engine-browser.cjs",
    "test:school-pilot-browser": "node tests/school-pilot-browser.cjs",
    "test:browser-smoke": "node scripts/test-browser.mjs smoke",
    "test:browser-flows": "node scripts/test-browser.mjs flows",
    "test:browser-ocr": "node scripts/test-browser.mjs ocr",
    "build:offline": "node scripts/build-offline.mjs",
    "test:browser-field": "node scripts/test-browser.mjs field",
    "test:scale": "node --test tests/field-scale.test.js",
    "test:pedagogical": "node --test tests/teaching.test.js",
    "test:pedagogical-browser": "node tests/teaching-browser.cjs",
    "test:analytics": "node --test tests/institutional-analytics.test.js",
    "test:analytics-browser": "node tests/analytics-browser.cjs",
    "test:hemeroteca": "node --test tests/serials.test.js",
    "test:hemeroteca-browser": "node tests/hemeroteca-browser.cjs",
    "test:institutional": "node --test tests/organization.test.js",
    "test:institutional-browser": "node tests/organization-browser.cjs && node tests/organization-responsive-browser.cjs && node tests/organization-migration-browser.cjs",
    "test:entry": "node --test tests/entry.test.js",
    "test:entry-browser": "node tests/entry-browser.cjs",
    "test:help-browser": "node tests/help-browser.cjs",
    "build:help": "node scripts/build-help.mjs",
    "test:audit": "node --test tests/audit-v2.simulation.js",
    "test:shard": "node scripts/test-shard.mjs"
  }
}
